#!/bin/bash
# Wrapper for SLPlugin to properly handle CEF in Flatpak

# Ensure library path is set
export LD_LIBRARY_PATH=/app/extra/lib:/app/lib:${LD_LIBRARY_PATH}

# CEF needs to find its resources
export CHROME_WRAPPER=/app/bin/zypak-wrapper

# Disable CEF's sandbox since Flatpak provides it
# Even though you said this didn't work standalone, it might work with Zypak
export ZYPAK_DISABLE_SANDBOX=1

# Run the actual SLPlugin binary with zypak
exec /app/bin/zypak-wrapper /app/extra/bin/SLPlugin.real "$@"
